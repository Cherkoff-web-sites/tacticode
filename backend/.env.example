PORT=4000
DATABASE_URL=postgres://user:password@localhost:5432/tacticode
JWT_SECRET=change_me_to_long_random_string
# Без SUPER_ADMIN_EMAIL / SUPER_ADMIN_EMAILS админский вход и bootstrap отключены.
# Для Docker этого достаточно и для backend, и для UI.
SUPER_ADMIN_EMAIL=first@example.com
SUPER_ADMIN_EMAILS=first@example.com,second@example.com,third@example.com

