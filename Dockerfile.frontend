# Frontend для Timeweb: сборка из корня репо
# Использовать при создании Frontend-app с типом Docker
FROM node:20-alpine AS build

WORKDIR /app
COPY prod/package*.json ./
RUN npm install
COPY prod/ ./
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
